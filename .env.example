# Copy to .env and use your own credentials. Never commit the real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
OPENROUTER_API_KEY=replace-me
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-me
ATTACK_DATA_DIR=data

# API authentication. Generate a random secret; never share it with the LLM prompt.
API_KEY=replace-me
# Set this to the externally reachable HTTPS URL before importing OpenAPI into Dify.
API_BASE_URL=http://127.0.0.1:8000
# Use a restricted SELECT-only role before public deployment. If omitted, local demo
# requests use DATABASE_URL. Do not expose an owner/admin connection to the internet.
API_DATABASE_URL=
